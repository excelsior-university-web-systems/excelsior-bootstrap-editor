{
    "apiVersion": 3,
    "name": "excelsior-bootstrap-editor/accordion",
    "title": "Accordion",
    "description": "Create a collapsible component used to organize content into expandable sections.",
    "category": "excelsior-bootstrap-editor-blocks",
    "parent": ["excelsior-bootstrap-editor/container", "core/group"],
    "supports": {
        "html": false
    },
    "example": {
        "attributes": {
            "cover": "admin/images/accordion.webp"
        }
    },
    "attributes": {
        "accordionHeadingLevel": {
            "type": "string",
            "default": "h2"
        },
        "accordionHeadingSize": {
            "type": "string",
            "default": "h4"
        }
    },
    "providesContext": {
        "excelsior-bootstrap-editor/accordionHeadingLevel": "accordionHeadingLevel",
        "excelsior-bootstrap-editor/accordionHeadingSize": "accordionHeadingSize"
    }
}
