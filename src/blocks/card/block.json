{
    "apiVersion": 3,
    "name": "excelsior-bootstrap-editor/card",
    "title": "Card",
    "description": "Create a card.",
    "category": "excelsior-bootstrap-editor-blocks",
    "parent": ["excelsior-bootstrap-editor/cards"],
    "supports": {
        "html": false
    },
    "usesContext": [
        "excelsior-bootstrap-editor/cardBgColor",
        "excelsior-bootstrap-editor/cardAspectRatio"
    ],
    "attributes": {
        "useImg": {
            "type": "boolean",
            "default": true
        },
        "imgUrl": {
            "type": "string"
        },
        "imgAltText": {
            "type": "string",
            "default": ""
        },
        "enlargeable": {
            "type": "boolean",
            "default": false
        },
        "bgColor": {
            "type": "string",
            "default": ""
        },
        "aspectRatio": {
            "type": "string",
            "default": "16x9"
        }
    }
}
