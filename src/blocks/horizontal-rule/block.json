{
    "apiVersion": 3,
    "name": "excelsior-bootstrap-editor/horizontal-rule",
    "title": "Horizontal Rule",
    "description": "Create a thematic break or divider between content sections.",
    "category": "excelsior-bootstrap-editor-blocks",
    "parent": ["excelsior-bootstrap-editor/container", "core/group"],
    "supports": {
        "html": false
    },
    "example": {
        "attributes": {
            "cover": "admin/images/horizontal-rule.webp"
        }
    },
    "attributes": {
        "selectedIcon": {
            "type": "string",
            "default": "bi-house"
        },
        "size": {
            "type": "string",
            "default": "large"
        },
        "decorative": {
            "type": "boolean",
            "default": true
        },
        "noIcon": {
            "type": "boolean",
            "default": false
        },
        "styleType" : {
            "type": "string",
            "default" : "red"
        }
    }
}
