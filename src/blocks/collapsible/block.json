{
    "apiVersion": 3,
    "name": "excelsior-bootstrap-editor/collapsible",
    "title": "Collapsible",
    "description": "Create a collapsible component that allows authors to show or hide additional content.",
    "category": "excelsior-bootstrap-editor-blocks",
    "parent": ["excelsior-bootstrap-editor/container"],
    "supports": {
        "html": false
    },
    "example": {
        "attributes": {
            "cover": "admin/images/collapsible.webp"
        }
    },
    "providesContext": {
        "excelsior-bootstrap-editor/collapsibleContentId": "uniqueId"
    },
    "attributes": {
        "cover": {
            "type": "string",
            "default": ""
        },
        "uniqueId": {
            "type": "string"
        },
        "buttonText": {
            "type": "string",
            "default": "Show"
        },
        "styleType": {
            "type": "string",
            "default": ""
        },
        "_collapsibleContentId": {
            "type": "string"
        },
        "_collapsibleContentInnerBlocks": {
            "type": "array",
            "default": []
        }
    }
}
