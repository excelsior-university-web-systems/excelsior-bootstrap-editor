{
    "apiVersion": 3,
    "name": "excelsior-bootstrap-editor/info-box",
    "title": "Info Box",
    "description": "Create a brief, optional guidance to help learners succeed in the course.",
    "category": "excelsior-bootstrap-editor-blocks",
    "parent": ["excelsior-bootstrap-editor/container", "core/group"],
    "supports": {
        "html": false,
        "splitting": false
    },
    "example": {
        "attributes": {
            "cover": "admin/images/info-box.webp"
        }
    },
    "attributes": {
        "styleType": {
            "type": "string",
            "default": "tip"
        },
        "content": {
            "type": "string",
            "default": ""
        },
        "narrowWidth": {
            "type": "boolean",
            "default": false
        }
    }
}
