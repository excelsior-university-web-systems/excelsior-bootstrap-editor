            "default": ""
        },
        "termDefinition": {
            "type": "string",
            "default": ""
        },
        "hasIndentation": {
            "type": "boolean",
            "default": false
        }
    },
    "usesContext": [
        "excelsior-bootstrap-editor/useIndentationForDefinitions"
    ]
}